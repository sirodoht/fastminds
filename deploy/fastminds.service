[Unit]
Description=fastminds
After=network.target

[Service]
Type=simple
User=deploy
Group=deploy
WorkingDirectory=/var/www/fastminds
EnvironmentFile=/var/www/fastminds/.env
ExecStartPre=/usr/bin/bun run src/migrate.ts
ExecStartPre=/usr/bin/bun run build:frontend
ExecStart=/usr/bin/bun run src/index.ts

Restart=on-failure
RestartSec=5

[Install]
WantedBy=multi-user.target
